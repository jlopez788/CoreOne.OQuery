<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- NuGet package metadata -->
        <PackageId>CoreOne.OQuery</PackageId>
        <Version>1.0.0</Version>
        <Title>CoreOne.OQuery</Title>
        <Description>A lightweight, extensible query language engine for .NET. Parses OQuery expressions into LINQ predicates that run against any IQueryable&lt;T&gt;. Supports filtering, nested property paths, IN lists, logical operators, built-in string functions, and LIMIT/OFFSET pagination.</Description>
        <Authors>Juan Lopez</Authors>
        <Company>Juan Lopez</Company>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/jlopez788/CoreOne.OQuery</PackageProjectUrl>
        <RepositoryUrl>https://github.com/jlopez788/CoreOne.OQuery</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>oquery;query;linq;filter;parser;queryable;expression;predicate</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!-- Documentation and symbols -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CoreOne" Version="1.5.5" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="/" />
    </ItemGroup>

</Project>
