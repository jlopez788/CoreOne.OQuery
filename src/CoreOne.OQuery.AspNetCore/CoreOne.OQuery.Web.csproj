<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet package metadata -->
    <PackageId>CoreOne.OQuery.AspNetCore</PackageId>
    <Version>1.0.0</Version>
    <Title>CoreOne.OQuery.AspNetCore</Title>
    <Description>ASP.NET Core integration for CoreOne.OQuery. Provides automatic model binding and DI registration so that OQuery expressions can be bound directly to controller action parameters from the request query string.</Description>
    <Authors>Juan Lopez</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jlopez788/CoreOne.OQuery</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jlopez788/CoreOne.OQuery</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>oquery;aspnetcore;model-binding;query;linq;filter;middleware</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Documentation and symbols -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CoreOne.OQuery\CoreOne.OQuery.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
